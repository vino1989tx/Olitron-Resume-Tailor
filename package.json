{
  "name": "resume-tailor",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "generate-env": "node tools/generate-environment.mjs",
    "generate-env:prod": "node tools/generate-environment.mjs --prod",
    "start": "npm run generate-env && ng serve",
    "build": "npm run generate-env:prod && ng build",
    "build:dev": "npm run generate-env && ng build --configuration development",
    "test": "ng test --watch=false"
  },
  "dependencies": {
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/platform-browser": "^20.3.0",
    "docx": "^9.7.1",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "pdfjs-dist": "^4.9.378",
    "rxjs": "~7.8.0",
    "tslib": "^2.8.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.3.0",
    "@angular/cli": "^20.3.0",
    "@angular/compiler-cli": "^20.3.0",
    "@types/jasmine": "~5.1.0",
    "zone.js": "~0.15.0",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.9.0"
  }
}
