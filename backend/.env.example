# Copy to .env and fill in. This file is safe to commit; .env is git-ignored.

# Your Google Gemini API key — lives ONLY on the server, never shipped to the browser.
GEMINI_API_KEY=your-gemini-key-here

# Optional: which Gemini model to use.
GEMINI_MODEL=gemini-2.5-flash

# Comma-separated browser origins allowed to call this API (Angular site + local dev).
FRONTEND_ORIGIN=http://localhost:4200,https://your-site.netlify.app
